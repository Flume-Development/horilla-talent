# Nuxt Frontend Environment Configuration
# Copy this file to .env.local and update with your settings

# API Configuration
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000
NUXT_PUBLIC_API_TIMEOUT=30000

# Application Settings
NUXT_APP_NAME=Horilla HR
NODE_ENV=development

# Development Server
NUXT_HOST=0.0.0.0
NUXT_PORT=3000

# Feature Flags
NUXT_PUBLIC_ENABLE_FACE_DETECTION=true
NUXT_PUBLIC_ENABLE_GEOFENCING=true
